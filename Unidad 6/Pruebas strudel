//Confort chain

setcpm(50)

const GoodOn = 0
const prueba = 1
const BadOn = 0

const {visualid} = createParams('visualid')


const goodpiano1 = note(`<[[[g5 b5 d5 e5] f#5] [[f#5 Bb5 d5 e5] f#5] [[d5 f#5 a5 b5 db6]@2 b5]*2]@5 >`) 
              .sound("gm_steel_drums").coarse(4).visualid("piano1").postgain(prueba ? 0.75 : 0) 
const goodpiano2 = note(`<[[a1, db2, e2]*2]@4 [b1, db2, e2]@2 [b1, db2, f#2]@2>`) 
              .sound("gm_fx_goblins").coarse(4).visualid("piano1").postgain(GoodOn ? 0.75 : 0) 

const badpiano1 = note(`<[[eb3 e3 b3 ab3]*3]@8>`) 
              .sound("gm_guitar_harmonics").visualid("piano1").postgain(BadOn ? 0.75 : 0) 

const badpiano2 = note(`<[a1, db2, e2]@5.5 [b1, db2, e2]@5 [b1, db2, f#2]@5>`) 
              .sound("gm_fx_goblins").visualid("piano1").postgain(BadOn ? 0.75 : 0)

$goodpiano1: stack(goodpiano1, goodpiano1.osc())
$goodpiano2: stack(goodpiano2, goodpiano2.osc())
$badpiano1: stack(badpiano1, badpiano1.osc())
$badpiano2: stack(badpiano2, badpiano2.osc())
